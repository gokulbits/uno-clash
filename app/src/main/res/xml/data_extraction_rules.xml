<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" stops cloud backups, but from Android 12 phone-to-phone transfers need this too.
  Nothing here is worth moving: the seat token only decrypts with this phone's keystore key anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
